# Application settings. Every APP_* value is optional; defaults live in app.config.Settings.
# Lists use JSON. Uncomment a line to override it.
# APP_NAME=FastAPI App                         # OpenAPI title and telemetry service name
# APP_ENVIRONMENT=development                  # development, production, or test
# APP_LOG_LEVEL=INFO                           # DEBUG, INFO, WARNING, ERROR, CRITICAL
# APP_LOG_FORMAT=json                          # json or console; default is console in development
# APP_DOCS_ENABLED=true                        # /docs and /openapi.json; default is off in production
# APP_CORS_ORIGINS=["https://app.example.com"] # empty list disables cross-origin browser requests
# APP_CORS_ALLOW_CREDENTIALS=false
# APP_CORS_ALLOW_HEADERS=["Authorization","Content-Type","X-Request-ID"]
# APP_ALLOWED_HOSTS=["localhost","127.0.0.1"]  # add your public API hostname
# APP_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# APP_READINESS_TIMEOUT=2.0                    # seconds per storage probe
# APP_READINESS_CACHE_TTL=5.0                  # seconds to reuse the last /ready result

# Optional storage. Install the matching uv extra, then set the DSN (or ClickHouse host) to enable it.
# Values match the dev Compose profiles; inside the dev container use the service name as host.
# APP_POSTGRES_RAW__DSN=postgresql://app:app@localhost:5432/app
# APP_POSTGRES_RAW__MIN_SIZE=0
# APP_POSTGRES_RAW__MAX_SIZE=10
# APP_POSTGRES_RAW__CONNECT_TIMEOUT=5.0
# APP_POSTGRES_ORM__DSN=postgresql+psycopg://app:app@localhost:5432/app
# APP_POSTGRES_ORM__POOL_SIZE=5
# APP_POSTGRES_ORM__MAX_OVERFLOW=10
# APP_POSTGRES_ORM__POOL_TIMEOUT=10.0
# APP_POSTGRES_ORM__CONNECT_TIMEOUT=5
# APP_CLICKHOUSE__HOST=localhost
# APP_CLICKHOUSE__PORT=8123
# APP_CLICKHOUSE__USERNAME=default
# APP_CLICKHOUSE__PASSWORD=
# APP_CLICKHOUSE__DATABASE=default
# APP_CLICKHOUSE__SECURE=false
# APP_CLICKHOUSE__CONNECT_TIMEOUT=5.0
# APP_MONGODB__DSN=mongodb://localhost:27017
# APP_MONGODB__MAX_POOL_SIZE=100
# APP_MONGODB__SERVER_SELECTION_TIMEOUT=5.0
# APP_REDIS__DSN=redis://localhost:6379/0
# APP_REDIS__MAX_CONNECTIONS=50
# APP_REDIS__SOCKET_TIMEOUT=5.0
# APP_REDIS__SOCKET_CONNECT_TIMEOUT=5.0

# Docker Compose settings (not read by the application)
IMAGE_REF=fastapi-app:dev                 # Use ghcr.io/OWNER/REPO:X.Y.Z on a VPS
APP_PORT=8000                             # Binds to 127.0.0.1 on the Docker host
# FORWARDED_ALLOW_IPS=*                   # Proxies trusted for X-Forwarded-*; see deployment docs
